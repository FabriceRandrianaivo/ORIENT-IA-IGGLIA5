# Cles API optionnelles d'ORIENT'IA — copier ce fichier en ".env" (sans .example)
# a la racine du projet et remplir. Le fichier .env est ignore par Git : les
# cles ne partent JAMAIS sur GitHub.
#
# L'agent detecte automatiquement la premiere cle disponible dans cet ordre :
# Anthropic > Gemini > Groq. Sans aucune cle : mode deterministe (100% local).

# Google AI Studio (gratuit) : https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq (gratuit) : https://console.groq.com/keys
GROQ_API_KEY=

# Anthropic (payant, optionnel)
# ANTHROPIC_API_KEY=

# Modeles (optionnel, valeurs par defaut sinon)
# GEMINI_MODEL=gemini-flash-latest
# GROQ_MODEL=llama-3.3-70b-versatile
